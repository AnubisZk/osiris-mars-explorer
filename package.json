{
  "name": "zsk-flight-core",
  "version": "1.0.0",
  "description": "ZSK FPV uçuş çekirdeği: Rapier 240 Hz fizik, uçuş kontrolcüsü, altı drone türü, kumanda ve rüzgâr. Çizimden bağımsız.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./*": "./src/*" },
