    "test": "node --test tests/*.test.js",
    "trace": "node tools/flighttrace.mjs",
    "check": "npm test && npm run trace",
    "dev": "vite examples/minimal --open"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "engines": { "node": ">=22" }
}
